# ─── Security ────────────────────────────────────────────────────────────────

SECRET_KEY=replace-with-a-strong-production-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ─── Database ─────────────────────────────────────────────────────────────────

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=irdm_db
DATABASE_USER=irdm_user
DATABASE_PASSWORD=your-password-here

# ─── Localization ─────────────────────────────────────────────────────────────

LANGUAGE_CODE=en
TIME_ZONE=Asia/Ho_Chi_Minh

# ─── Email ────────────────────────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this value stable. Changing it prevents existing SMTP passwords from being decrypted.
EMAIL_CREDENTIAL_KEY=replace-with-a-long-random-secret
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
